# Copy to .dev.vars (gitignored) for `uv run pywrangler dev`. Values here override [vars] in
# wrangler.toml. Use made-up values locally; the real ones are Worker secrets.
ENVIRONMENT=development
ANTHROPIC_API_KEY=
SESSION_SECRET=
ADMIN_TOKEN=
# Bearer key for the fast slot (FAST_BASE_URL in wrangler.toml); only POST /api/ai/score reads it.
FAST_API_KEY=
# Optional, when you have no keys: the fake model API (uv run python tests/fake_anthropic.py), e.g.
# ANTHROPIC_BASE_URL=http://127.0.0.1:8790
# FAST_BASE_URL=http://127.0.0.1:8790/v1
