# Made-up values for tests/smoke.sh only (loaded with --env-file, so your own .dev.vars is not
# used). Nothing here is a real secret; the model API is tests/fake_anthropic.py.
ENVIRONMENT=smoke
ANTHROPIC_API_KEY=fake-key-for-smoke-test
SESSION_SECRET=smoke-session-secret
ADMIN_TOKEN=smoke-admin-token
FAST_API_KEY=fake-fast-key-for-smoke-test
ANTHROPIC_BASE_URL=http://127.0.0.1:8790
FAST_BASE_URL=http://127.0.0.1:8790/v1
# Fixed here so the smoke test does not depend on what wrangler.toml currently deploys.
MODEL_CHAT=claude-sonnet-5-5
MODEL_ANALYZE=claude-haiku-5-5
MODEL_FAST=fast-model-for-smoke
TOTAL_TOKEN_BUDGET=100000000
