 "prompts": [
  {
   "id": "s3_p01",
   "text": "What's the difference between supervised and unsupervised learning?",
   "step": 1,
   "session_id": "s3_drift",
   "chat_id": "c1"
  },
  {
   "id": "s3_p02",
   "text": "Why do we need a separate test set if we already have a validation set?",
   "step": 2,
   "session_id": "s3_drift",
   "chat_id": "c1"
  },
  {
   "id": "s3_p03",
   "text": "What is overfitting and how can I tell it's happening from the loss curves?",
   "step": 3,
   "session_id": "s3_drift",
   "chat_id": "c1"
  },
  {
   "id": "s3_p04",
   "text": "Can you explain the bias-variance tradeoff with a simple example?",
   "step": 4,
   "session_id": "s3_drift",
   "chat_id": "c1"
  },
  {
   "id": "s3_p05",
   "text": "How does k-fold cross-validation work?",
   "step": 5,
   "session_id": "s3_drift",
   "chat_id": "c1"
  },
  {
   "id": "s3_p06",
   "text": "Is accuracy a bad metric for imbalanced classes? What should I use instead?",
   "step": 6,
   "session_id": "s3_drift",
   "chat_id": "c1"
  },
  {
   "id": "s3_p07",
   "text": "Why does L1 regularization give sparse weights but L2 doesn't?",
   "step": 7,
   "session_id": "s3_drift",
   "chat_id": "c1"
  },
  {
   "id": "s3_p08",
   "text": "What problem do recurrent neural networks solve that feedforward ones don't?",
   "step": 8,
   "session_id": "s3_drift",
   "chat_id": "c1"
  },
  {
   "id": "s3_p09",
   "text": "Why do LSTMs have gates? What's the forget gate for?",
   "step": 9,
   "session_id": "s3_drift",
   "chat_id": "c1"
  },
  {
   "id": "s3_p10",
   "text": "What's the problem with RNNs on long sentences?",
   "step": 10,
   "session_id": "s3_drift",
   "chat_id": "c1"
  },
  {
   "id": "s3_p11",
   "text": "What is attention in seq2seq models? The decoder 'looks at' the encoder states?",
   "step": 11,
   "session_id": "s3_drift",
   "chat_id": "c2"
  },
  {
   "id": "s3_p12",
   "text": "In self-attention, what are queries, keys and values? Where do they come from?",
   "step": 12,
   "session_id": "s3_drift",
   "chat_id": "c2"
  },
  {
   "id": "s3_p13",
   "text": "Why do we divide by sqrt(d_k) in scaled dot-product attention?",
   "step": 13,
   "session_id": "s3_drift",
   "chat_id": "c2"
  },
  {
   "id": "s3_p14",
   "text": "How does the transformer know the word order if attention is permutation invariant?",
   "step": 14,
   "session_id": "s3_drift",
   "chat_id": "c2"
  },
  {
   "id": "s3_p15",
   "text": "Why sinusoidal positional encodings instead of just learning position embeddings?",
   "step": 15,
   "session_id": "s3_drift",
   "chat_id": "c2"
  },
  {
   "id": "s3_p16",
   "text": "What's the point of multi-head attention? Isn't one head enough?",
