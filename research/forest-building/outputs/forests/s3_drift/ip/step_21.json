   "session_id": "s3_drift",
   "chat_id": "c2"
  },
  {
   "id": "s3_p20",
   "text": "How do the heads get combined after multi-head attention, just concatenation?",
   "step": 20,
   "session_id": "s3_drift",
   "chat_id": "c2"
  },
  {
   "id": "s3_p21",
