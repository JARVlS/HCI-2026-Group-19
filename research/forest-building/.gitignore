.venv/
__pycache__/
.pytest_cache/
.ipynb_checkpoints/
.env
# Working cache of every embedding and judge call (raw answers, ledger). The submission reads the
# committed snapshot in data/frozen/ instead (python -m forest.cache freeze).
data/cache/
# Per-step snapshots are regenerated by 05_simulation_and_baselines.ipynb. Only the IP's sequence
# (what the prototype loads) is committed; every method keeps app_final.json and decisions.jsonl.
outputs/forests/*/*/step_*.json
outputs/forests/*/*/app_sequence.json
!outputs/forests/*/ip/step_*.json
!outputs/forests/*/ip/app_sequence.json
dist/
