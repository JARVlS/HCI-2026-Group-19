# Copy to .env (git-ignored). Only needed for live judge calls; the offline judge and the
# cached answers need nothing.

# judge.backend = anthropic: the Claude API (or run `ant auth login` instead of a key)
ANTHROPIC_API_KEY=

# judge.backend = proxy: an OpenAI- and Anthropic-compatible endpoint, e.g. the Bedrock stand-in
# that research/thinking-filter uses (default http://127.0.0.1:8790)
PROXY_URL=
